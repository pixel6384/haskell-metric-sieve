name:                haskell-metric-sieve
version:             0.1.0.0
category:            Utility
build-type:          Simple
cabal-version:       >=1.10

executable metric-sieve
  main-is:             Main.hs
  other-modules:       Sieve
  hs-source-dirs:      src
  build-depends:       base >= 4.7 && < 5
                     , text
                     , conduit
                     , conduit-extra
  default-language:    Haskell2010